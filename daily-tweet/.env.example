# X(Twitter) API 認証情報（OAuth 1.0a User Context）
# X Developer Portal の App から発行してコピーし、このファイルを .env にリネームして使う。
# App の権限は "Read and Write" にすること。

# API Key / API Key Secret（= Consumer Keys / App Key・App Secret）
TWITTER_APP_KEY=your_api_key_here
TWITTER_APP_SECRET=your_api_key_secret_here

# Access Token / Access Token Secret（自分のアカウントの User Context トークン）
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here
